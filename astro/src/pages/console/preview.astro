---
/**
 * 控制台文章整页预览
 * 稿件通过 sessionStorage 从控制台传入 (mc00_console_preview), 支持 markdown / mdx / html 三种格式
 */
export const prerender = true;

import BaseLayout from "@layouts/base.astro";
---

<BaseLayout title="文章预览 · 控制台" description="控制台文章整页预览">
    <div id="swup-container" class="w-full min-h-screen flex flex-col items-center relative z-20">
        <div class="w-full max-w-4xl px-4 sm:px-6 py-6 sm:py-10">
            <div id="preview-banner" class="mb-4 hidden">
                <div class="card-base liquid-glass rounded-2xl px-4 py-2.5 border border-black/5 dark:border-white/10 text-xs flex items-center justify-between gap-3">
                    <span class="font-bold text-(--primary) flex items-center gap-2">
                        <span id="preview-format-badge" class="console-count-badge h-5 min-w-6 px-2 text-[10px]">MD</span>
                        <span>控制台预览 · 未发布稿件 (仅本地)</span>
                    </span>
                    <span id="preview-meta-right" class="font-mono text-neutral-400"></span>
                </div>
            </div>

            <article id="preview-article" class="card-base liquid-glass rounded-3xl border border-black/5 dark:border-white/8 shadow-xl p-6 sm:p-9 space-y-5">
                <header class="space-y-3 pb-4 border-b border-black/5 dark:border-white/10">
                    <h1 id="preview-title" class="text-2xl sm:text-3xl font-black text-neutral-900 dark:text-white leading-snug">
                        正在载入预览…
                    </h1>
                    <p id="preview-description" class="text-sm text-neutral-500 dark:text-neutral-400 hidden"></p>
                    <div id="preview-meta" class="flex items-center gap-3 sm:gap-4 text-[11px] font-mono text-neutral-400 flex-wrap"></div>
                    <div id="preview-tags" class="flex items-center gap-1.5 flex-wrap"></div>
                </header>

                <div id="preview-cover" class="hidden rounded-2xl overflow-hidden border border-black/5 dark:border-white/10">
                    <img alt="封面" class="w-full h-auto object-cover" />
                </div>

                <div id="preview-body" class="console-preview-body custom-md prose dark:prose-invert max-w-none text-sm sm:text-base"></div>
            </article>

            <div id="preview-empty" class="hidden card-base liquid-glass rounded-3xl p-12 text-center text-sm text-neutral-500">
                没有可预览的稿件。请回到控制台文章列表或编辑器, 点击「预览」重新打开本页。
            </div>
        </div>
    </div>
</BaseLayout>

<style is:global>
    body:has(#preview-article) #pio-container,
    body:has(#preview-article) .glass-bg-dock {
        display: none !important;
    }
</style>

<script>
    import {
        readConsolePreview,
        renderContent,
        hydratePreview,
        ensurePreviewStyles,
        buildSandboxDocument,
    } from "@/console/preview";
    import { normalizeContentFormat } from "@/console/markdown";

    function setText(id: string, value: string): void {
        const node = document.getElementById(id);
        if (node) node.textContent = value;
    }

    function renderMeta(payload: NonNullable<ReturnType<typeof readConsolePreview>>): void {
        const meta = document.getElementById("preview-meta");
        if (!meta) return;
        const parts: string[] = [];
        if (payload.author) parts.push(`作者: ${payload.author}`);
        const date = (payload.updatedAt || payload.createdAt || "").split("T")[0];
        if (date) parts.push(`日期: ${date}`);
        if (payload.wordCount) parts.push(`字数: ${payload.wordCount}`);
        if (payload.readingTime) parts.push(`约 ${payload.readingTime} 分钟`);
        if (payload.folderPath) parts.push(`文件夹: ${payload.folderPath}`);
        else parts.push("文件夹: 文章根目录");
        meta.innerHTML = parts
            .map((item) => `<span class="px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10">${item}</span>`)
            .join("");

        const tags = document.getElementById("preview-tags");
        if (tags) {
            const list = payload.tags || [];
            tags.innerHTML = list
                .map((tag) => `<span class="px-2 py-0.5 rounded-full text-[11px] font-mono text-(--primary) bg-(--primary)/10 border border-(--primary)/25">#${tag}</span>`)
                .join("");
        }

        const right = document.getElementById("preview-meta-right");
        if (right) {
            const statusText = payload.status === "published" ? "已发布" : payload.status === "recycle" ? "回收站" : "草稿";
            right.textContent = `状态: ${statusText} · Slug: ${payload.slug || "untitled"}`;
        }
    }

    function boot(): void {
        ensurePreviewStyles();

        const payload = readConsolePreview();
        const article = document.getElementById("preview-article");
        const empty = document.getElementById("preview-empty");
        if (!payload || !article) {
            article?.classList.add("hidden");
            empty?.classList.remove("hidden");
            return;
        }

        const format = normalizeContentFormat(payload.format);
        const banner = document.getElementById("preview-banner");
        banner?.classList.remove("hidden");
        setText("preview-format-badge", format === "html" ? "HTML" : format === "mdx" ? "MDX" : "MD");

        setText("preview-title", payload.title || "未命名文章");
        if (payload.summary) {
            const description = document.getElementById("preview-description");
            if (description) {
                description.textContent = payload.summary;
                description.classList.remove("hidden");
            }
        }

        if (payload.cover) {
            const cover = document.getElementById("preview-cover");
            const image = cover?.querySelector("img");
            if (cover && image) {
                (image as HTMLImageElement).src = payload.cover;
                cover.classList.remove("hidden");
            }
        }

        renderMeta(payload);

        const body = document.getElementById("preview-body");
        if (!body) return;

        if (format === "html") {
            const isDark = document.documentElement.classList.contains("dark");
            const iframe = document.createElement("iframe");
            iframe.className = "w-full min-h-[70vh] rounded-2xl border border-black/5 dark:border-white/10 bg-white dark:bg-neutral-950";
            iframe.setAttribute("sandbox", "allow-same-origin");
            iframe.setAttribute("title", "HTML 正文预览");
            iframe.srcdoc = buildSandboxDocument(payload.content, { dark: isDark, mode: "styled" });
            body.innerHTML = "";
            body.appendChild(iframe);
            return;
        }

        body.innerHTML = renderContent({ content: payload.content, format });
        void hydratePreview(body as HTMLElement);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
    } else {
        boot();
    }
</script>
