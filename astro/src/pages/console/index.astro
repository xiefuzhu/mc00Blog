---
export const prerender = true;

import BaseLayout from "@layouts/base.astro";
import ConsoleApp from "@/account/ConsoleApp.svelte";
import FullscreenWallpaper from "@components/fullscreenWallpaper.astro";
import { siteConfig } from "@/config";
---

<BaseLayout title="CPAMC 控制台 · 博客管理控制台" description="CPAMC 风格现代化博客管理工作台">
    <!-- 全屏壁纸支持 (与博客首页一致的视觉基底) -->
    <FullscreenWallpaper
        config={siteConfig.wallpaper}
        class="opacity-25 dark:opacity-15 pointer-events-none fixed inset-0 z-0 transition-opacity duration-300"
    />
    <!-- 专属全屏沉浸式工作台容器 -->
    <div id="swup-container" class="w-full min-h-screen flex flex-col justify-start items-stretch relative z-20 overflow-x-hidden">
        <ConsoleApp client:load />
    </div>
</BaseLayout>

<style is:global>
    /* 控制台页面移除前台不必要的组件覆盖与干扰 */
    body:has(#swup-container .console-app-root) {
        overflow-x: hidden;
    }
    body:has(#swup-container .console-app-root) #navbar,
    body:has(#swup-container .console-app-root) .glass-bg-dock,
    body:has(#swup-container .console-app-root) #pio-container,
    body:has(#swup-container .console-app-root) .site-footer {
        display: none !important;
    }
</style>
