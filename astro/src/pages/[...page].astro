---
// 首页分页: 文章列表在请求时从 PHP 后端获取, 因此按需渲染 (后端不可达时列表为空)
export const prerender = false;

import { PAGE_SIZE } from "@constants/pagination";
import { getSortedPosts } from "@utils/post";
import { url } from "@utils/url";
import Pagination from "@components/pagination.astro";
import PostPage from "@components/postPage.astro";
import GridLayout from "@layouts/grid.astro";


const currentPage = Math.max(1, Number.parseInt(Astro.params.page ?? "1", 10) || 1);
const allBlogPosts = await getSortedPosts();

const lastPage = Math.max(1, Math.ceil(allBlogPosts.length / PAGE_SIZE));
const start = (currentPage - 1) * PAGE_SIZE;
const pageData = allBlogPosts.slice(start, start + PAGE_SIZE);

const page = {
    data: pageData,
    currentPage,
    lastPage,
    total: allBlogPosts.length,
    size: PAGE_SIZE,
    start,
    end: start + pageData.length,
    url: {
        current: currentPage === 1 ? url("/") : url(`/${currentPage}/`),
        prev: currentPage > 1 ? (currentPage === 2 ? url("/") : url(`/${currentPage - 1}/`)) : undefined,
        next: currentPage < lastPage ? url(`/${currentPage + 1}/`) : undefined,
    },
};

const len = page.data.length;
---

<GridLayout>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation-up" page={page} style={`animation-delay: ${(len)*50}ms`}></Pagination>
</GridLayout>
